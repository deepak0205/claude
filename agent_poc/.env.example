# Copy to .env and fill in real values. Nothing in this file is read
# directly by the app except via config/settings.py (pydantic-settings).

# --- Anthropic ---
ANTHROPIC_API_KEY=

# Per-role model overrides (see plan's "Model / Embedding Choices" table).
# Leave unset to use the in-code defaults in config/settings.py.
SUPERVISOR_MODEL=claude-sonnet-5
SUBAGENT_MODEL=claude-sonnet-5
SYNTHESIS_MODEL=claude-opus-5
MEMORY_SUMMARIZER_MODEL=claude-haiku-4-5-20251001

# --- Voyage AI embeddings ---
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3.5

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- PubMed / NCBI E-utilities ---
NCBI_EMAIL=
NCBI_API_KEY=

# --- Demo seeding ---
DEMO_TOPIC_QUERY=EGFR AND lung cancer
DEMO_MAX_RESULTS=200

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# --- Addendum 3 source config ---

# ChEMBL REST API — no key required.
CHEMBL_BASE_URL=https://www.ebi.ac.uk/chembl/api/data

# DrugBank open-vocabulary CSV path. This is DrugBank's free, license-free
# "open structures"/"open vocabulary" download (drug names, synonyms, and
# external IDs only — no mechanism/interaction data), NOT the licensed
# DrugBank API or full database. Download it yourself from
# https://go.drugbank.com/releases/latest#open-data and point this at the
# local CSV; there is no sensible default path.
DRUGBANK_VOCAB_PATH=

# ClinicalTrials.gov REST API v2 — no key required.
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2

# OpenTargets GraphQL API — no key required.
OPENTARGETS_GRAPHQL_URL=https://api.platform.opentargets.org/api/v4/graphql

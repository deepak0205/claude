# Normally the user supplies their own Groq API key via the frontend's sidebar field
# (sent per-request, never persisted to disk). GROQ_API_KEY below is only a fallback
# for local/dev testing without the UI.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

OTEL_ENABLED=false
OTEL_SERVICE_NAME=case-study-chatbot

RETRIEVAL_TOP_K=3
CHUNK_SIZE_WORDS=200
CHUNK_OVERLAP_WORDS=40

MEMORY_SUMMARY_BUDGET_RATIO=0.12
MEMORY_RECENT_TURNS=8

APP_ENV=dev
LOG_LEVEL=INFO
